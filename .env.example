# --- Mode ---------------------------------------------------------------
# DEMO_MODE=true runs everything offline: mock providers, SQLite, in-memory
# cache/queue, zero API keys required.
DEMO_MODE=true

# --- Database -----------------------------------------------------------
# Leave unset in demo mode (SQLite at backend/data/leaselens.sqlite3).
# Production (docker compose): postgresql+asyncpg://leaselens:leaselens@postgres:5432/leaselens
# DATABASE_URL=

# --- Cache / queue ------------------------------------------------------
# Leave unset in demo mode (in-memory cache, in-process jobs).
# REDIS_URL=redis://redis:6379/0

# --- LLM providers ------------------------------------------------------
# LLM_PROVIDER=mock | anthropic | openai
LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- External data providers (all optional; mocks used when unset) ------
# RENTCAST_API_KEY=
# OPENROUTESERVICE_API_KEY=
# GOOGLE_PLACES_API_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# --- Budgets ------------------------------------------------------------
RUN_BUDGET_USD=0.50
RUN_BUDGET_TOKENS=200000
FANOUT_CONCURRENCY=5

# --- Auth ---------------------------------------------------------------
# Demo mode auto-signs you in as demo@leaselens.dev.
JWT_SECRET=change-me-in-production

# --- Telemetry (optional) -----------------------------------------------
# LANGFUSE_HOST=http://langfuse:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# --- Frontend -----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
